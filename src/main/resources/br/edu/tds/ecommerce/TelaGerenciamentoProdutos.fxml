<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="500.0" minWidth="900.0" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.tds.ecommerce.TelaGerenciamentoProdutosController">
   <top>
      <HBox alignment="CENTER" prefHeight="70.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Gerenciamento de Produtos" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   
   <left>
      <VBox prefWidth="280.0" spacing="12.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Edição do Produto">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>

            <Label fx:id="lblMensagem" wrapText="true">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Nome do Produto" />
                  <TextField fx:id="txtNome" prefHeight="30.0" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Descrição" />
                  <TextField fx:id="txtDescricao" prefHeight="30.0" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Preço (R$)" />
                  <TextField fx:id="txtPreco" prefHeight="30.0" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Quantidade em Estoque" />
                  <TextField fx:id="txtEstoque" prefHeight="30.0" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Categoria" />
                  <TextField fx:id="txtCategoria" prefHeight="30.0" />
               </children>
            </VBox>
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#salvarAlteracoes" prefHeight="40.0" style="-fx-background-color: #28a745; -fx-cursor: hand;" text="Salvar Alterações" textFill="WHITE">
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </left>

   <center>
      <TableView fx:id="tabelaProdutos" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colNome" prefWidth="150.0" text="Nome" />
          <TableColumn fx:id="colDescricao" prefWidth="180.0" text="Descrição" />
          <TableColumn fx:id="colPreco" prefWidth="100.0" text="Preço" />
          <TableColumn fx:id="colEstoque" prefWidth="100.0" text="Estoque" />
          <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoria" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>

   <bottom>
      <HBox alignment="CENTER" prefHeight="80.0" spacing="25.0" style="-fx-background-color: #f1f1f1; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#abrirTelaCadastroProduto" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #007bff; -fx-cursor: hand;" text="+ Novo" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#editarProduto" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #ffc107; -fx-cursor: hand;" text="Editar" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#excluirProduto" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #dc3545; -fx-cursor: hand;" text="Excluir" textFill="WHITE" />
         </children>
      </HBox>
   </bottom>
</BorderPane>